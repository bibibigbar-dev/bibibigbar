NEXT_PUBLIC_SITE_URL=https://bibibigbar.com
NEXT_PUBLIC_BLOG_URL=https://blog.bibibigbar.com

# Same database as amatdda. Blog tables are public.blog_*.
# Leave the service role empty to keep using the local JSON store.
SUPABASE_URL=https://obpgjzrltdwvhyynafkx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# OpenAI-compatible writer. Leave the key empty until you want drafts.
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
BLOG_AUTHOR_NAME=bibibigbar
# The manual "Write the next topic" button publishes when this is true, and saves a draft when false.
# The daily edition still publishes at 6:00, 9:00, 12:00, 15:00, and 18:00 Asia/Seoul.
BLOG_AUTO_PUBLISH=false
CRON_SECRET=

# AdSense. Slots are the data-ad-slot ids from the AdSense ad units.
NEXT_PUBLIC_ADSENSE_CLIENT=
NEXT_PUBLIC_ADSENSE_SLOT_FEED=
NEXT_PUBLIC_ADSENSE_SLOT_ARTICLE=

# Search Console HTML tag content value, not the whole meta tag.
GOOGLE_SITE_VERIFICATION=

AUTH_SECRET=
# Password for the only account, bibibigbar@gmail.com.
ADMIN_PASSWORD=
