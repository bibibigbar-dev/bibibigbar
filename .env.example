# OpenAI-compatible writer. Leave the key empty until you want drafts.
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
BLOG_AUTHOR_NAME=bibibigbar
# The manual "Write the next topic" button publishes when this is true, and saves a draft when false.
# GitHub Actions calls /api/blog/auto-publish at 5, 6, 9, 12, 15, and 18 Asia/Seoul.
# 5:00 writes five briefings. The later hours publish the one that is due.
BLOG_AUTO_PUBLISH=false
CRON_SECRET=

# AdSense. These defaults also apply when the variables are unset or empty.
